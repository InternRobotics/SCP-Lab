        },
        "required": [
          "target_celsius",
          "duration_s"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "type": "object",
        "required": [
          "validated_command",
          "source",
          "limitations"
        ],
        "properties": {
          "validated_command": {
            "type": "object"
          },
          "source": {
            "type": "object"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "completion_criteria": "The declared parameter schema accepts the request.",
      "access_level": "L3"
    }
  ]
}
