{
  "schema_version": "scp-lab.device-model.v0.1",
  "model_id": "thermo_fisher_atc",
  "device_class": "thermocycler",
  "display_name": "Thermo Fisher ATC",
  "capabilities": [
    {
      "capability_id": "thermo_fisher_atc.thermal_cycling",
      "version": "0.1.0",
      "description": "Run thermal cycling with the specified cycle count and temperature steps.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "parameters": {
            "type": "object",
            "properties": {
              "cycles": {
                "type": "integer",
                "description": "Number of cycles.",
                "minimum": 1
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "description": "Thermal cycle steps. The execution layer requires each item to include temperature and duration.",
                "items": {
                  "type": "object",
                  "properties": {
                    "temperature": {
                      "type": "number",
                      "description": "Step temperature in °C.",
                      "x-scp-unit": "degC"
                    },
                    "duration": {
                      "type": "number",
                      "description": "Step hold duration in seconds.",
                      "x-scp-unit": "s"
                    }
                  },
                  "required": [
                    "temperature",
                    "duration"
                  ]
                }
              }
            },
            "required": [
              "cycles",
              "steps"
            ],
            "additionalProperties": false
          },
          "bindings": {
            "type": "object",
            "properties": {
              "sample": {
                "type": "object",
                "properties": {
                  "resource_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "position": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sample_id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "resource_id"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "sample"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "parameters",
          "bindings"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "type": "object",
        "required": [
          "validated_command",
          "source",
          "limitations"
        ],
        "properties": {
          "validated_command": {
            "type": "object"
          },
          "source": {
            "type": "object"
          },
          "limitations": {
            "type": "array"
          }
        }
      },
      "completion_criteria": "Published parameter and binding schemas pass validation; no device operation is performed.",
      "access_level": "L3",
      "defaults_policy": "not_applied",
      "limitations": []
    }
  ]
}
