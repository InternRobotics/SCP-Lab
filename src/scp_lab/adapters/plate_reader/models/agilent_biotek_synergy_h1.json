{
  "schema_version": "scp-lab.device-model.v0.1",
  "model_id": "agilent_biotek_synergy_h1",
  "device_class": "plate_reader",
  "display_name": "Agilent BioTek Synergy H1",
  "capabilities": [
    {
      "capability_id": "agilent_biotek_synergy_h1.plate_reading",
      "version": "0.1.0",
      "description": "Read optical signals from a microplate.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "parameters": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "description": "Plate-reading mode.",
                "enum": [
                  "absorbance",
                  "fluorescence",
                  "luminescence"
                ]
              },
              "wavelength": {
                "type": "number",
                "description": "Absorbance wavelength in nm. Required when mode=absorbance.",
                "exclusiveMinimum": 0,
                "x-scp-unit": "nm"
              },
              "excitation_wavelength": {
                "type": "number",
                "description": "Excitation wavelength in nm. Required when mode=fluorescence.",
                "exclusiveMinimum": 0,
                "x-scp-unit": "nm"
              },
              "emission_wavelength": {
                "type": "number",
                "description": "Emission wavelength in nm. Required when mode=fluorescence.",
                "exclusiveMinimum": 0,
                "x-scp-unit": "nm"
              },
              "focal_height": {
                "type": "number",
                "description": "Focal height. Available for fluorescence/luminescence; defaults to the device default if omitted.",
                "minimum": 0
              }
            },
            "required": [
              "mode"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "mode": {
                      "const": "absorbance"
                    }
                  },
                  "required": [
                    "mode"
                  ]
                },
                "then": {
                  "required": [
                    "wavelength"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "mode": {
                      "const": "fluorescence"
                    }
                  },
                  "required": [
                    "mode"
                  ]
                },
                "then": {
                  "required": [
                    "excitation_wavelength",
                    "emission_wavelength"
                  ]
                }
              }
            ],
            "additionalProperties": false
          },
          "bindings": {
            "type": "object",
            "properties": {
              "sample": {
                "type": "object",
                "properties": {
                  "resource_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "position": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sample_id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "resource_id"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "sample"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "parameters",
          "bindings"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "type": "object",
        "required": [
          "validated_command",
          "source",
          "limitations"
        ],
        "properties": {
          "validated_command": {
            "type": "object"
          },
          "source": {
            "type": "object"
          },
          "limitations": {
            "type": "array"
          }
        }
      },
      "completion_criteria": "Published parameter and binding schemas pass validation; no device operation is performed.",
      "access_level": "L3",
      "defaults_policy": "not_applied",
      "limitations": []
    }
  ]
}
