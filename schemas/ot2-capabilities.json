[
  {
    "capability_id": "ot2.liquid_transfer",
    "version": "0.1.0",
    "device_id": "ot2",
    "access_level": "L3",
    "description": "Transfer liquid between two wells using one fresh tip.",
    "input_schema": {
      "$defs": {
        "WellRef": {
          "additionalProperties": false,
          "properties": {
            "labware": {
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
              "title": "Labware",
              "type": "string"
            },
            "well": {
              "pattern": "^[A-H](?:[1-9]|1[0-2])$",
              "title": "Well",
              "type": "string"
            }
          },
          "required": [
            "labware",
            "well"
          ],
          "title": "WellRef",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/WellRef"
        },
        "destination": {
          "$ref": "#/$defs/WellRef"
        },
        "volume_ul": {
          "exclusiveMinimum": 0,
          "title": "Volume Ul",
          "type": "number",
          "x-scp-unit": "uL"
        }
      },
      "required": [
        "source",
        "destination",
        "volume_ul"
      ],
      "title": "Transfer",
      "type": "object"
    },
    "execution_modes": [
      "compile",
      "official_simulation"
    ],
    "implementation_status": "implemented",
    "hardware_validation": "not_performed",
    "simulation_validation": "reported_per_run",
    "completion_criteria": "Official simulator returns without error; this establishes simulation completion only.",
    "setup_required": true
  },
