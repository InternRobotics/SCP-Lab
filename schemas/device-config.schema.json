{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "scp-lab.device-config.v0.1",
      "default": "scp-lab.device-config.v0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "device_id": {
      "minLength": 1,
      "title": "Device Id",
      "type": "string"
    },
    "backend": {
      "pattern": "^[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*:[A-Za-z_]\\w*$",
      "title": "Backend",
      "type": "string"
    },
    "display_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Display Name"
    },
    "enabled": {
      "default": true,
      "title": "Enabled",
      "type": "boolean"
    },
    "connection": {
      "additionalProperties": true,
      "title": "Connection",
      "type": "object"
    },
    "options": {
      "additionalProperties": true,
      "title": "Options",
      "type": "object"
    }
  },
  "required": [
    "device_id",
    "backend"
  ],
  "title": "DeviceConfig",
  "type": "object"
}
